# ============================================================
# MicroIntern — Environment Variables Reference
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env files containing real secrets.
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
APP_NAME=MicroIntern
APP_VERSION=0.1.0
LOG_LEVEL=debug

# ── API Server ──────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://microintern:microintern_pass@127.0.0.1:5433/microintern_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT Authentication ───────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64
JWT_REFRESH_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=microintern
JWT_AUDIENCE=microintern-api

# ── OAuth — Google ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/google/callback

# ── OAuth — GitHub ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/github/callback

# ── Storage (MinIO / S3) ─────────────────────────────────────
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PUBLIC=microintern-public
MINIO_BUCKET_PRIVATE=microintern-private
MINIO_SIGNED_URL_EXPIRES=3600

# For production AWS S3:
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_PUBLIC=
# S3_BUCKET_PRIVATE=

# ── Email (Nodemailer) ───────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=MicroIntern
EMAIL_FROM_ADDRESS=noreply@microintern.io

# For production Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# ── AI Gateway ───────────────────────────────────────────────
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDERS=openrouter,gemini,ollama

# Groq
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=8192
GROQ_TIMEOUT_MS=30000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=https://microintern.io
OPENROUTER_SITE_NAME=MicroIntern

# Google Gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Ollama (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# HuggingFace
HUGGINGFACE_API_KEY=
HUGGINGFACE_DEFAULT_MODEL=meta-llama/Llama-3.2-3B-Instruct

# OpenAI
OPENAI_API_KEY=

# ── Slack Integration ─────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_CHANNEL_ID=C0BMS5BGD2L

# ── Webhooks ──────────────────────────────────────────────────
WEBHOOK_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# ── Security ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ── BullMQ ───────────────────────────────────────────────────
QUEUE_CONCURRENCY_EMAIL=5
QUEUE_CONCURRENCY_AI_EVALUATION=2
QUEUE_CONCURRENCY_NOTIFICATION=10
QUEUE_CONCURRENCY_STORAGE=5

# ── Feature Flags (Foundation) ────────────────────────────────
FEATURE_OAUTH_ENABLED=true
FEATURE_AI_EVALUATION_ENABLED=true
FEATURE_AUDIT_LOG_ENABLED=true

# OAuth — LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:4000/api/v1/auth/linkedin/callback

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/microsoft/callback
