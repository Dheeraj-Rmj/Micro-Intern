{
  "name": "@microintern/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, generated client, and database utilities for MicroIntern",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node -e \"require('fs').cpSync('src/generated', 'dist/generated', {recursive: true, force: true})\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "tsx src/seed/index.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf src/generated"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@microintern/shared": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.2.0",
    "@microintern/config": "workspace:*",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.21.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
