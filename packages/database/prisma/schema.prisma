// ============================================================
// MicroIntern — Prisma Schema
// ============================================================
// Design Principles:
//   - UUID v4 primary keys on all entities (non-enumerable, secure)
//   - Audit fields (createdAt, updatedAt, createdBy, updatedBy) on all entities
//   - Soft deletes (deletedAt, deletedBy) on all business entities
//   - Explicit foreign key names for clear migration diffs
//   - Strategic indexes for all FK columns and common query patterns
//   - Row-level security ready (userId-scoped queries enforced in repositories)
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// USERS & AUTHENTICATION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model User {
  id       String       @id @default(uuid()) @db.Uuid
  email    String       @unique
  username String?      @unique
  role     Role
  status   EntityStatus @default(PENDING_VERIFICATION)

  name          String?
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?

  // Profile
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  avatarUrl String? @map("avatar_url")
  phone     String?

  // Security
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  lastLoginIp     String?   @map("last_login_ip")
  loginAttempts   Int       @default(0) @map("login_attempts")
  lockedUntil     DateTime? @map("locked_until")
  forcePasswordChange Boolean @default(false) @map("force_password_change")
  
  // MFA
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  totpSecret      String?   @map("totp_secret") // Encrypted TOTP secret
  webAuthnCurrentChallenge String? @map("webauthn_current_challenge")

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  // Relations
  oauthAccounts      OAuthAccount[]
  webAuthnCredentials WebAuthnCredential[]
  sessions           Session[]
  devices            UserDevice[]
  candidateProfile   CandidateProfile?
  companyMembership  CompanyMember[]
  auditLogsCreated   AuditLog[]          @relation("AuditLogCreatedBy")
  notifications      Notification[]
  verificationTokens VerificationToken[]
  sentInvitations    Invitation[]        @relation("InvitationSentBy")
  accounts           Account[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Email verification and password-reset tokens.
/// Tokens are stored HASHED — plain token is emailed to the user.
/// Tokens are single-use and time-limited.
model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @map("token_hash") @db.Text
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// Invitation records for recruiter and admin onboarding.
/// No public registration — accounts are created through invitations only.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  role        Role
  companyId   String?   @map("company_id") @db.Uuid
  invitedById String    @map("invited_by_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.Text
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  invitedBy User @relation("InvitationSentBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("invitations")
}

/// WebAuthn credentials for hardware keys and biometrics
model WebAuthnCredential {
  id           String   @id // The credential ID base64url encoded
  userId       String   @map("user_id") @db.Uuid
  publicKey    Bytes    @map("public_key")
  counter      BigInt   @default(0)
  deviceType   String   @map("device_type")
  backedUp     Boolean  @default(false) @map("backed_up")
  transports   String[] // Array of transports (e.g. 'usb', 'ble', 'nfc', 'internal')
  name         String?  // Optional user-friendly name for the key
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  accessToken       String?       @map("access_token") @db.Text
  refreshToken      String?       @map("refresh_token") @db.Text
  expiresAt         DateTime?     @map("expires_at")
  tokenType         String?       @map("token_type")
  scope             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  token            String    @unique
  refreshTokenHash String?   @map("refresh_token_hash") @db.Text
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent") @db.Text
  deviceType       String?   @map("device_type") // desktop, mobile, tablet, unknown
  browser          String?   @map("browser")     // Chrome, Safari, Firefox, Edge, etc.
  os               String?   @map("os")          // Windows, macOS, iOS, Android, Linux
  city             String?   @map("city")
  country          String?   @map("country")
  region           String?   @map("region")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String    @db.Text
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("verifications")
}

/// Tracks user devices for anomaly detection.
model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  ipAddress   String   @map("ip_address")
  userAgent   String   @map("user_agent")
  fingerprint String   @map("fingerprint") // Hash of IP + UA
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  isTrusted   Boolean  @default(true) @map("is_trusted")
  
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fingerprint])
  @@unique([userId, fingerprint])
  @@map("user_devices")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CANDIDATE DOMAIN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model CandidateProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Profile content
  headline String? @db.VarChar(255)
  bio      String? @db.Text
  location String? @db.VarChar(255)

  // Storage
  resumeUrl    String?      @map("resume_url")
  resumeStatus ResumeStatus @default(UPLOADED) @map("resume_status")

  // Scoring / Computed
  completionPercentage Int @default(0) @map("completion_percentage")

  // Job Hunting
  yearsOfExperience Int?    @map("years_of_experience")
  isOpenToWork      Boolean @default(true) @map("is_open_to_work")
  isPublic          Boolean @default(false) @map("is_public")
  
  // Privacy & Network Controls
  visibility        Json?   // e.g. { profile: "PUBLIC", assessments: "CONNECTIONS", messages: "RECRUITERS" }

  // Phase 3 OS
  globalRank Int? @map("global_rank")

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]

  // Candidate Graph Relations
  aiAnalyses          CandidateAIAnalysis[]
  skills              CandidateSkill[]
  experiences         CandidateExperience[]
  educations          CandidateEducation[]
  certificates        CandidateCertificate[]
  socials             CandidateSocial[]
  preferences         CandidatePreference?
  TalentPoolCandidate TalentPoolCandidate[]

  @@index([userId])
  @@index([isOpenToWork])
  @@index([deletedAt])
  @@map("candidate_profiles")
}

model CandidateAIAnalysis {
  id          String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid

  provider String
  model    String

  resumeScore     Float?   @map("resume_score")
  atsScore        Float?   @map("ats_score")
  profileScore    Float?   @map("profile_score")
  summary         String?  @db.Text
  recommendations String[]

  createdAt DateTime @default(now()) @map("created_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_ai_analyses")
}

model CandidateSkill {
  id          String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid

  skill            String           @db.VarChar(100)
  level            Int              @default(1) // 1-5
  verified         Boolean          @default(false)
  proficiencyLevel SkillProficiency @default(BEGINNER) @map("proficiency_level")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_skills")
}

model CandidateExperience {
  id          String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid

  company     String    @db.VarChar(255)
  role        String    @db.VarChar(255)
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_experiences")
}

model CandidateEducation {
  id          String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid

  institution  String    @db.VarChar(255)
  degree       String    @db.VarChar(255)
  fieldOfStudy String?   @map("field_of_study") @db.VarChar(255)
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_educations")
}

model CandidateCertificate {
  id          String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid

  name           String    @db.VarChar(255)
  issuer         String    @db.VarChar(255)
  issueDate      DateTime  @map("issue_date")
  expirationDate DateTime? @map("expiration_date")
  url            String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_certificates")
}

model CandidateSocial {
  id          String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid

  platform String @db.VarChar(50) // 'github', 'linkedin', etc.
  url      String @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, platform])
  @@map("candidate_socials")
}

model CandidatePreference {
  id          String @id @default(uuid()) @db.Uuid
  candidateId String @unique @map("candidate_id") @db.Uuid

  employmentType EmploymentType[] @map("employment_type")
  workMode       WorkMode[]       @map("work_mode")
  noticePeriod   NoticePeriod?    @map("notice_period")
  expectedSalary String?          @map("expected_salary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_preferences")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMPANY DOMAIN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model CompanyOnboarding {
  id                   String           @id @default(uuid()) @db.Uuid
  token                String           @unique @db.VarChar(100)
  status               OnboardingStatus @default(PENDING)
  superAdminId         String           @map("super_admin_id") @db.Uuid

  companyName          String?          @map("company_name") @db.VarChar(255)
  size                 String?          @db.VarChar(50)
  division             String?          @db.VarChar(100)
  location             String?          @db.VarChar(255)
  
  adminName            String?          @map("admin_name") @db.VarChar(255)
  adminEmail           String?          @map("admin_email") @db.VarChar(255)
  
  logoUrl              String?          @map("logo_url")
  govDocUrls           Json?            @map("gov_doc_urls")
  docVerificationScore Json?            @map("doc_verification_score")
  faceScanData         Json?            @map("face_scan_data")
  signatureUrl         String?          @map("signature_url")
  mouUrl               String?          @map("mou_url")

  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([token])
  @@index([status])
  @@map("company_onboardings")
}

model Company {
  id     String       @id @default(uuid()) @db.Uuid
  name   String       @db.VarChar(255)
  slug   String       @unique @db.VarChar(100)
  status     EntityStatus @default(PENDING_VERIFICATION)
  ekycStatus EkycStatus   @default(UNVERIFIED) @map("ekyc_status")

  // Identity
  logoUrl     String?      @map("logo_url")
  websiteUrl  String?      @map("website_url")
  description String?      @db.Text
  industry    String?      @db.VarChar(100)
  size        CompanySize?
  location    String?      @db.VarChar(255)
  linkedinUrl             String? @map("linkedin_url")
  stripeIdentitySessionId String? @map("stripe_identity_session_id")
  ekycDocuments           Json?   @map("ekyc_documents")

  // Billing
  planTier PlanTier @default(FREE) @map("plan_tier")

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  members        CompanyMember[]
  assessments    Assessment[]
  TalentPool     TalentPool[]
  departments    CompanyDepartment[]
  analytics      CompanyAnalyticsSnapshot[]
  billing        CompanyBilling?
  aiInsights     AIInsightRecommendation[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("companies")
}

model CompanyMember {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      Role // COMPANY_OWNER or RECRUITER
  invitedBy String?   @map("invited_by") @db.Uuid
  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([role])
  @@map("company_members")
}

model CompanyDepartment {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(255)
  headcount   Int      @default(0)
  budget      Float    @default(0.0)
  status      String   @default("Active") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_departments")
}

model CompanyAnalyticsSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  snapshotDate         DateTime @default(now()) @map("snapshot_date")
  timeToHireDays       Float    @map("time_to_hire_days")
  offerAcceptanceRate  Float    @map("offer_acceptance_rate")
  candidateDropRate    Float    @map("candidate_drop_rate")
  totalPlacements      Int      @map("total_placements")
  
  // JSON field for funnel data
  funnelData           Json?    @map("funnel_data")
  
  // JSON field for source data
  sourceData           Json?    @map("source_data")
  
  createdAt            DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([snapshotDate])
  @@map("company_analytics_snapshots")
}

model CompanyBilling {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @unique @map("company_id") @db.Uuid
  stripeCustomerId String?  @map("stripe_customer_id")
  planName         String   @default("Free Plan") @db.VarChar(100)
  renewalDate      DateTime? @map("renewal_date")
  
  recruiterSeatsUsed Int    @default(1) @map("recruiter_seats_used")
  recruiterSeatsMax  Int    @default(5) @map("recruiter_seats_max")
  
  aiCreditsUsed      Int    @default(0) @map("ai_credits_used")
  aiCreditsMax       Int    @default(100) @map("ai_credits_max")
  
  storageUsedBytes   BigInt @default(0) @map("storage_used_bytes")
  storageMaxBytes    BigInt @default(1073741824) @map("storage_max_bytes") // 1GB
  
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_billing")
}

model AIInsightRecommendation {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  type        String   @db.VarChar(100) // 'SKILL_SHORTAGE', 'MARKET_TREND', 'STRATEGY'
  title       String   @db.VarChar(255)
  description String   @db.Text
  severity    String?  @db.VarChar(50) // 'High', 'Medium', 'Critical'
  metadata    Json?
  
  createdAt   DateTime @default(now()) @map("created_at")
  isDismissed Boolean  @default(false) @map("is_dismissed")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@map("ai_insight_recommendations")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASSESSMENT DOMAIN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Assessment {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  createdById String           @map("created_by_id") @db.Uuid
  status      AssessmentStatus @default(DRAFT)

  // Content
  title          String           @db.VarChar(255)
  slug           String           @db.VarChar(100)
  description    String           @db.Text
  instructions   String           @db.Text
  skillsRequired String[]         @map("skills_required")
  roleTitle      String?          @map("role_title") @db.VarChar(255)
  level          ExperienceLevel?

  // Configuration
  durationMinutes Int     @map("duration_minutes")
  passingScore    Int     @default(70) @map("passing_score")
  maxAttempts     Int     @default(1) @map("max_attempts")
  isPublic        Boolean @default(false) @map("is_public")

  // CTO Architectural Extensions
  complexityScore            Int? @map("complexity_score")
  aiDifficultyScore          Int? @map("ai_difficulty_score")
  estimatedExperienceYears   Int? @map("estimated_experience_years")
  estimatedCompletionMinutes Int? @map("estimated_completion_minutes")

  // Publishing window
  publishedAt DateTime? @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  // Audit
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text
  restoredAt   DateTime? @map("restored_at")
  restoredBy   String?   @map("restored_by") @db.Uuid

  company            Company                 @relation(fields: [companyId], references: [id])
  tasks              AssessmentTask[]
  submissions        Submission[]
  pipeline           Pipeline?
  sections           AssessmentSection[]
  deliverables       AssessmentDeliverable[]
  attachments        AssessmentAttachment[]
  resources          AssessmentResource[]
  versions           AssessmentVersion[]
  aiMetadata         AssessmentAIMetadata[]
  competencyMappings CompetencyMapping[]
  skillTrails        SkillTrailAssessment[]
  learningOutcomes   LearningOutcome[]
  activityTimeline   ActivityTimelineEntry[]
  promptVersions     PromptVersion[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
  @@map("assessments")
}

model AssessmentTask {
  id           String  @id @default(uuid()) @db.Uuid
  assessmentId String  @map("assessment_id") @db.Uuid
  sectionId    String? @map("section_id") @db.Uuid
  sortOrder    Int     @map("sort_order")

  // Content
  title       String   @db.VarChar(255)
  description String   @db.Text
  taskType    TaskType @map("task_type")
  isRequired  Boolean  @default(true) @map("is_required")

  // Scoring & CTO Extensions
  maxPoints       Int      @default(100) @map("max_points")
  weight          Float?   @default(0)
  expectedOutput  String?  @map("expected_output") @db.Text
  evaluationNotes String?  @map("evaluation_notes") @db.Text
  examples        String[] @default([])

  // Metadata (flexible for different task types)
  config Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment         Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section            AssessmentSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  submissionAnswers  SubmissionAnswer[]
  criteria           RubricCriteria[]
  competencyMappings CompetencyMapping[]

  @@index([assessmentId, sortOrder])
  @@index([sectionId])
  @@map("assessment_tasks")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SUBMISSION DOMAIN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Submission {
  id            String           @id @default(uuid()) @db.Uuid
  assessmentId  String           @map("assessment_id") @db.Uuid
  candidateId   String           @map("candidate_id") @db.Uuid
  status        SubmissionStatus @default(INVITED)
  attemptNumber Int              @default(1) @map("attempt_number")

  // Timing
  invitedAt   DateTime  @default(now()) @map("invited_at")
  startedAt   DateTime? @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  expiresAt   DateTime? @map("expires_at")

  // Scoring
  totalScore Float?   @map("total_score")
  isPassed   Boolean? @map("is_passed")

  // Workspace
  workspaceId String? @map("workspace_id") @db.Uuid

  // Phase 7: AI Integrity Engine
  integrityScore Float?  @map("integrity_score")
  integrityFlags Json?   @map("integrity_flags")
  isSuspicious   Boolean @default(false) @map("is_suspicious")

  // Audit & soft delete
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text
  restoredAt   DateTime? @map("restored_at")
  restoredBy   String?   @map("restored_by") @db.Uuid

  assessment       Assessment                  @relation(fields: [assessmentId], references: [id])
  candidate        CandidateProfile            @relation(fields: [candidateId], references: [id])
  answers          SubmissionAnswer[]
  evaluation       Evaluation?
  sections         SubmissionSection[]
  deliverableItems SubmissionDeliverableItem[]
  files            SubmissionFile[]
  links            SubmissionLink[]

  @@unique([assessmentId, candidateId, attemptNumber])
  @@index([assessmentId])
  @@index([candidateId])
  @@index([status])
  @@index([deletedAt])
  @@map("submissions")
}

model SubmissionAnswer {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  taskId       String @map("task_id") @db.Uuid

  // Answer content (flexible for different task types)
  answerText    String? @map("answer_text") @db.Text
  answerFileUrl String? @map("answer_file_url")
  answerData    Json?   @map("answer_data")

  // Scoring (set by evaluation)
  earnedPoints Float?  @map("earned_points")
  feedback     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  task       AssessmentTask @relation(fields: [taskId], references: [id])

  @@unique([submissionId, taskId])
  @@index([submissionId])
  @@index([taskId])
  @@map("submission_answers")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EVALUATION DOMAIN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Evaluation {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @unique @map("submission_id") @db.Uuid
  status       EvaluationStatus @default(PENDING)

  // AI provider that performed the evaluation
  aiProvider    String? @map("ai_provider")
  aiModel       String? @map("ai_model")
  promptVersion String? @map("prompt_version")

  // Results
  totalScore       Float?   @map("total_score")
  maxPossibleScore Float?   @map("max_possible_score")
  percentageScore  Float?   @map("percentage_score")
  isPassed         Boolean? @map("is_passed")
  summary          String?  @db.Text
  strengths        String[]
  improvements     String[]

  // Raw AI response (for audit and debugging)
  rawResponse Json? @map("raw_response")

  // Human review
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNotes String?   @map("review_notes") @db.Text

  // Timing
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Decision recommendation
  decision String? @db.VarChar(50) // STRONGLY_HIRE, HIRE, NO_HIRE, PENDING_REVIEW

  // Audit & soft delete
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text
  restoredAt   DateTime? @map("restored_at")
  restoredBy   String?   @map("restored_by") @db.Uuid

  submission       Submission        @relation(fields: [submissionId], references: [id])
  reviewerScores   ReviewerScore[]
  competencyScores CompetencyScore[]

  @@index([submissionId])
  @@index([status])
  @@index([deletedAt])
  @@map("evaluations")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PIPELINE DOMAIN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Pipeline {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  assessmentId String  @unique @map("assessment_id") @db.Uuid
  name         String  @db.VarChar(255)
  jobTitle     String  @map("job_title") @db.VarChar(255)
  isActive     Boolean @default(true) @map("is_active")

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  assessment Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  stages     PipelineStage[]
  candidates PipelineCandidate[]

  @@index([companyId])
  @@index([assessmentId])
  @@index([deletedAt])
  @@map("pipelines")
}

model PipelineStage {
  id         String            @id @default(uuid()) @db.Uuid
  pipelineId String            @map("pipeline_id") @db.Uuid
  name       String            @db.VarChar(255)
  stageType  PipelineStageType @map("stage_type")
  sortOrder  Int               @map("sort_order")
  config     Json              @default("{}")

  pipeline   Pipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  candidates PipelineCandidate[]

  @@index([pipelineId])
  @@map("pipeline_stages")
}

model PipelineCandidate {
  id         String   @id @default(uuid()) @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  stageId    String   @map("stage_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid // Candidate user ID
  movedAt    DateTime @default(now()) @map("moved_at")
  movedBy    String?  @map("moved_by") @db.Uuid
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id])
  stage    PipelineStage @relation(fields: [stageId], references: [id])

  @@index([pipelineId])
  @@index([stageId])
  @@index([userId])
  @@map("pipeline_candidates")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AUDIT & NOTIFICATIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// Immutable audit log — never updated, never soft-deleted.
/// Provides tamper-evident record for compliance.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String // AuditAction enum value
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  requestId  String?  @map("request_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogCreatedBy", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  type      String              @db.VarChar(100)
  title     String              @db.VarChar(255)
  body      String              @db.Text
  data      Json                @default("{}")
  isRead    Boolean             @default(false) @map("is_read")
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENUMS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum Role {
  SUPER_ADMIN
  ADMIN
  COMPANY_OWNER
  RECRUITER
  CANDIDATE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  ARCHIVED
}

enum EkycStatus {
  UNVERIFIED
  PENDING_MANUAL_REVIEW
  VERIFIED_STRIPE
  VERIFIED_MANUAL
  REJECTED
}

enum OnboardingStatus {
  PENDING
  SUBMITTED
  AUTO_VERIFIED
  APPROVED
  REJECTED
}

enum AssessmentStatus {
  DRAFT
  READY_FOR_REVIEW
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
  DELETED
}

enum SubmissionStatus {
  INVITED
  IN_PROGRESS
  SUBMITTED
  UNDER_EVALUATION
  EVALUATION_COMPLETE
  PASSED
  FAILED
  WITHDRAWN
  EXPIRED
}

enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_HUMAN_REVIEW
}

enum PipelineStageType {
  SCREENING
  SKILL_ASSESSMENT
  TECHNICAL_INTERVIEW
  CULTURE_FIT
  OFFER
  REJECTED
  WITHDRAWN
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  LINKEDIN
  MICROSOFT
}

enum TaskType {
  SHORT_ANSWER
  LONG_ANSWER
  MULTIPLE_CHOICE
  FILE_UPLOAD
  CODE_SUBMISSION
  LINK_SUBMISSION
}

enum ExperienceLevel {
  INTERNSHIP
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum CompanySize {
  SOLO
  SMALL // 1-10
  MEDIUM // 11-50
  LARGE // 51-200
  ENTERPRISE // 200+
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum ResumeStatus {
  UPLOADED
  PENDING_PARSE
  PARSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum NoticePeriod {
  IMMEDIATE
  DAYS_15
  DAYS_30
  DAYS_60
  DAYS_90
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
}

enum AssessmentSectionType {
  OVERVIEW
  TECHNICAL_TASKS
  COMMUNICATION_TASKS
  RESEARCH_TASKS
  OPTIONAL_BONUS
  SUBMISSION
}

enum DeliverableType {
  GITHUB_REPO
  FILE_UPLOAD
  LIVE_URL
  VIDEO_RECORDING
  MARKDOWN_TEXT
  FIGMA_LINK
  LOOM_VIDEO
}

enum TemplateCategory {
  BACKEND
  FRONTEND
  AI
  DEVOPS
  UI_UX
  MARKETING
  SALES
  FINANCE
  OPERATIONS
}

enum DifficultyLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
}

enum ResourceType {
  PDF
  MARKDOWN
  GITHUB
  NOTION
  FIGMA
  LOOM
  DOCUMENTATION
  VIDEO
  API_REFERENCE
  DATASET
  EXTERNAL_LINK
}

model AssessmentSection {
  id           String                @id @default(uuid()) @db.Uuid
  assessmentId String                @map("assessment_id") @db.Uuid
  title        String                @db.VarChar(255)
  description  String?               @db.Text
  sectionType  AssessmentSectionType @default(TECHNICAL_TASKS) @map("section_type")
  sortOrder    Int                   @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  tasks      AssessmentTask[]

  @@index([assessmentId, sortOrder])
  @@map("assessment_sections")
}

model RubricCriteria {
  id             String  @id @default(uuid()) @db.Uuid
  taskId         String  @map("task_id") @db.Uuid
  title          String  @db.VarChar(255)
  description    String  @db.Text
  weight         Float   @default(1.0)
  maxPoints      Int     @default(10) @map("max_points")
  expectedOutput String? @map("expected_output") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task               AssessmentTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  competencyMappings CompetencyMapping[]
  reviewerScores     ReviewerScore[]

  @@index([taskId])
  @@map("rubric_criteria")
}

model AssessmentDeliverable {
  id              String          @id @default(uuid()) @db.Uuid
  assessmentId    String          @map("assessment_id") @db.Uuid
  title           String          @db.VarChar(255)
  deliverableType DeliverableType @map("deliverable_type")
  isRequired      Boolean         @default(true) @map("is_required")
  description     String?         @db.Text
  config          Json            @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_deliverables")
}

model AssessmentAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  title        String   @db.VarChar(255)
  url          String
  fileType     String   @map("file_type") @db.VarChar(50)
  fileSize     Int?     @map("file_size")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_attachments")
}

model AssessmentResource {
  id           String       @id @default(uuid()) @db.Uuid
  assessmentId String       @map("assessment_id") @db.Uuid
  title        String       @db.VarChar(255)
  url          String
  resourceType ResourceType @map("resource_type")
  description  String?      @db.Text
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_resources")
}

model AssessmentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  assessmentId  String   @map("assessment_id") @db.Uuid
  versionNumber Int      @map("version_number")
  snapshot      Json
  changeSummary String?  @map("change_summary") @db.Text
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, versionNumber])
  @@index([assessmentId, createdAt])
  @@map("assessment_versions")
}

model AssessmentAIMetadata {
  id               String   @id @default(uuid()) @db.Uuid
  assessmentId     String   @map("assessment_id") @db.Uuid
  provider         String   @db.VarChar(50)
  model            String   @db.VarChar(100)
  promptVersion    String   @map("prompt_version") @db.VarChar(50)
  generatedAt      DateTime @default(now()) @map("generated_at")
  temperature      Float    @default(0.7)
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
