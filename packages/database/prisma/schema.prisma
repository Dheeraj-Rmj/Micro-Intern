enum SkillVerificationStatus {
  CLAIMED
  OBSERVED
  DEMONSTRATED
  AI_VERIFIED
  HUMAN_VERIFIED
  CERTIFIED
}

enum EvidenceType {
  GITHUB_REPO
  LIVE_DEPLOYMENT
  VIDEO_PRESENTATION
  ARCHITECTURE_DOC
  MARKDOWN
  PDF
  CODE_REVIEW
  PEER_REVIEW
  AI_ANALYSIS
}

enum EvidenceVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum CandidateJourneyStatus {
  INVITED
  ACCEPTED
  ASSESSMENT_STARTED
  ASSESSMENT_SUBMITTED
  AI_EVALUATED
  HUMAN_REVIEW
  SKILL_VERIFIED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
  CERTIFIED
}

enum SkillRelationshipType {
  PREREQUISITE
  RELATED
  CO_OCCURS
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SKILL FRAMEWORK & TAXONOMY
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model SkillCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skills Skill[]

  @@map("skill_categories")
}

model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  difficulty  Int      @default(3)
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category           SkillCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subSkills          SubSkill[]
  requiredInProfiles RequiredSkill[]
  evidenceMappings   EvidenceSkillMapping[]
  verifications      SkillVerificationRecord[]
  sourceRelations    SkillRelationship[]       @relation("SkillSourceRelation")
  targetRelations    SkillRelationship[]       @relation("SkillTargetRelation")

  @@index([categoryId])
  @@index([difficulty])
  @@map("skills")
}

model SubSkill {
  id          String   @id @default(uuid()) @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  difficulty  Int      @default(2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, name])
  @@index([skillId])
  @@map("sub_skills")
}

model SkillRelationship {
  id               String                @id @default(uuid()) @db.Uuid
  sourceSkillId    String                @map("source_skill_id") @db.Uuid
  targetSkillId    String                @map("target_skill_id") @db.Uuid
  relationshipType SkillRelationshipType @map("relationship_type")
  strength         Float                 @default(1.0)

  sourceSkill Skill @relation("SkillSourceRelation", fields: [sourceSkillId], references: [id], onDelete: Cascade)
  targetSkill Skill @relation("SkillTargetRelation", fields: [targetSkillId], references: [id], onDelete: Cascade)

  @@unique([sourceSkillId, targetSkillId, relationshipType])
  @@index([sourceSkillId])
  @@index([targetSkillId])
  @@map("skill_relationships")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ROLE PROFILE ENGINE (COMPANY HIRING EXPECTATIONS)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model SkillTrail {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  roleProfileId String?  @unique @map("role_profile_id") @db.Uuid
  title         String   @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  roleProfile   RoleProfile?             @relation(fields: [roleProfileId], references: [id], onDelete: SetNull)
  configuration SkillTrailConfiguration?
  assessments   SkillTrailAssessment[]

  @@index([companyId, isActive])
  @@map("skill_trails")
}

model SkillTrailConfiguration {
  id           String @id @default(uuid()) @db.Uuid
  skillTrailId String @unique @map("skill_trail_id") @db.Uuid

  // JSON stores the deep configuration: Question Distribution, Progression Rules, Feedback Rules
  rulesJson Json @map("rules_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skillTrail SkillTrail @relation(fields: [skillTrailId], references: [id], onDelete: Cascade)

  @@map("skill_trail_configurations")
}

model SkillTrailAssessment {
  id           String @id @default(uuid()) @db.Uuid
  skillTrailId String @map("skill_trail_id") @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid
  sortOrder    Int    @map("sort_order")

  skillTrail SkillTrail @relation(fields: [skillTrailId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([skillTrailId, assessmentId])
  @@index([skillTrailId, sortOrder])
  @@map("skill_trail_assessments")
}

model RoleProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  title               String   @db.VarChar(255)
  level               String   @default("MID") @db.VarChar(50)
  description         String?  @db.Text
  minimumOverallScore Float    @default(70.0) @map("minimum_overall_score")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  requiredSkills       RequiredSkill[]
  requiredCompetencies RequiredCompetency[]
  benchmarks           HiringBenchmark[]
  journeys             CandidateJourney[]
  skillTrail           SkillTrail?

  @@index([companyId, isActive])
  @@map("role_profiles")
}

model RequiredSkill {
  id            String  @id @default(uuid()) @db.Uuid
  roleProfileId String  @map("role_profile_id") @db.Uuid
  skillId       String  @map("skill_id") @db.Uuid
  minimumScore  Float   @default(70.0) @map("minimum_score")
  weight        Float   @default(1.0)
  isCritical    Boolean @default(false) @map("is_critical")

  roleProfile RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roleProfileId, skillId])
  @@index([roleProfileId])
  @@index([skillId])
  @@map("required_skills")
}

model RequiredCompetency {
  id            String @id @default(uuid()) @db.Uuid
  roleProfileId String @map("role_profile_id") @db.Uuid
  competencyId  String @map("competency_id") @db.Uuid
  minimumScore  Float  @default(75.0) @map("minimum_score")
  weight        Float  @default(1.0)

  roleProfile RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)
  competency  Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([roleProfileId, competencyId])
  @@index([roleProfileId])
  @@map("required_competencies")
}

model HiringBenchmark {
  id            String  @id @default(uuid()) @db.Uuid
  roleProfileId String  @map("role_profile_id") @db.Uuid
  metricName    String  @map("metric_name") @db.VarChar(100)
  targetValue   Float   @map("target_value")
  description   String? @db.Text

  roleProfile RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)

  @@index([roleProfileId])
  @@map("hiring_benchmarks")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FIRST-CLASS EVIDENCE ENGINE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Evidence {
  id                 String                     @id @default(uuid()) @db.Uuid
  candidateId        String                     @map("candidate_id") @db.Uuid
  submissionId       String?                    @map("submission_id") @db.Uuid
  title              String                     @db.VarChar(255)
  type               EvidenceType
  url                String
  description        String?                    @db.Text
  confidenceScore    Float                      @default(80.0) @map("confidence_score")
  qualityScore       Float                      @default(80.0) @map("quality_score")
  verificationStatus EvidenceVerificationStatus @default(PENDING) @map("verification_status")
  reviewNotes        String?                    @map("review_notes") @db.Text
  metadata           Json                       @default("{}")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  deletedAt          DateTime?                  @map("deleted_at")

  linkedSkills       EvidenceSkillMapping[]
  linkedCompetencies EvidenceCompetencyMapping[]

  @@index([candidateId, verificationStatus])
  @@index([submissionId])
  @@index([deletedAt])
  @@map("evidence")
}

model EvidenceSkillMapping {
  id         String  @id @default(uuid()) @db.Uuid
  evidenceId String  @map("evidence_id") @db.Uuid
  skillId    String  @map("skill_id") @db.Uuid
  confidence Float   @default(80.0)
  notes      String? @db.Text

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, skillId])
  @@index([evidenceId])
  @@index([skillId])
  @@map("evidence_skill_mappings")
}

model EvidenceCompetencyMapping {
  id           String  @id @default(uuid()) @db.Uuid
  evidenceId   String  @map("evidence_id") @db.Uuid
  competencyId String  @map("competency_id") @db.Uuid
  confidence   Float   @default(80.0)
  notes        String? @db.Text

  evidence   Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, competencyId])
  @@index([evidenceId])
  @@index([competencyId])
  @@map("evidence_competency_mappings")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SKILL VERIFICATION ENGINE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model SkillVerificationRecord {
  id               String                  @id @default(uuid()) @db.Uuid
  candidateId      String                  @map("candidate_id") @db.Uuid
  skillId          String                  @map("skill_id") @db.Uuid
  status           SkillVerificationStatus @default(CLAIMED)
  confidenceScore  Float                   @default(50.0) @map("confidence_score")
  verifiedById     String?                 @map("verified_by_id") @db.Uuid
  verificationNote String?                 @map("verification_note") @db.Text
  verifiedAt       DateTime?               @map("verified_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([candidateId, status])
  @@index([skillId])
  @@map("skill_verification_records")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIVING CANDIDATE PORTFOLIO ENGINE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model CandidatePortfolio {
  id                String   @id @default(uuid()) @db.Uuid
  candidateId       String   @unique @map("candidate_id") @db.Uuid
  publicSlug        String?  @unique @map("public_slug") @db.VarChar(100)
  bio               String?  @db.Text
  aiSummary         String?  @map("ai_summary") @db.Text
  isPublic          Boolean  @default(true) @map("is_public")
  githubUsername    String?  @map("github_username") @db.VarChar(100)
  linkedinUrl       String?  @map("linkedin_url")
  overallSkillScore Float    @default(0.0) @map("overall_skill_score")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  projects     PortfolioProject[]
  achievements PortfolioAchievement[]
  timeline     SkillTimelineEntry[]

  @@index([publicSlug, isPublic])
  @@map("candidate_portfolios")
}

model PortfolioProject {
  id          String   @id @default(uuid()) @db.Uuid
  portfolioId String   @map("portfolio_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String   @db.Text
  projectUrl  String?  @map("project_url")
  repoUrl     String?  @map("repo_url")
  skillsUsed  String[] @default([]) @map("skills_used")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  portfolio CandidatePortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, sortOrder])
  @@map("portfolio_projects")
}

model PortfolioAchievement {
  id          String   @id @default(uuid()) @db.Uuid
  portfolioId String   @map("portfolio_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  badgeUrl    String?  @map("badge_url")
  issuedAt    DateTime @default(now()) @map("issued_at")

  portfolio CandidatePortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_achievements")
}

model SkillTimelineEntry {
  id          String   @id @default(uuid()) @db.Uuid
  portfolioId String   @map("portfolio_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  timestamp   DateTime @default(now())
  metadata    Json     @default("{}")

  portfolio CandidatePortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp])
  @@map("skill_timeline_entries")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CANDIDATE SKILL JOURNEY (REPLACING ATS APPLICATIONS)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model CandidateJourney {
  id                   String                 @id @default(uuid()) @db.Uuid
  candidateId          String                 @map("candidate_id") @db.Uuid
  companyId            String                 @map("company_id") @db.Uuid
  roleProfileId        String?                @map("role_profile_id") @db.Uuid
  assessmentId         String?                @map("assessment_id") @db.Uuid
  submissionId         String?                @map("submission_id") @db.Uuid
  status               CandidateJourneyStatus @default(INVITED)
  overallScore         Float?                 @map("overall_score")
  skillMatchPercentage Float?                 @map("skill_match_percentage")
  notes                String?                @db.Text
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  roleProfile RoleProfile?              @relation(fields: [roleProfileId], references: [id], onDelete: SetNull)
  history     CandidateJourneyHistory[]

  @@index([candidateId, companyId])
  @@index([status])
  @@map("candidate_journeys")
}

model CandidateJourneyHistory {
  id          String                 @id @default(uuid()) @db.Uuid
  journeyId   String                 @map("journey_id") @db.Uuid
  fromStatus  CandidateJourneyStatus @map("from_status")
  toStatus    CandidateJourneyStatus @map("to_status")
  changedById String?                @map("changed_by_id") @db.Uuid
  reason      String?                @db.Text
  timestamp   DateTime               @default(now())

  journey CandidateJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, timestamp])
  @@map("candidate_journey_history")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INFRASTRUCTURE & SUPPORTING MODELS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model StorageObjectMetadata {
  id              String   @id @default(uuid()) @db.Uuid
  storageProvider String   @map("storage_provider") @db.VarChar(50)
  bucket          String   @db.VarChar(100)
  objectKey       String   @unique @map("object_key") @db.VarChar(500)
  filename        String   @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  checksum        String?  @db.VarChar(100)
  ownerId         String?  @map("owner_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("storage_object_metadata")
}

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  channel   String   @db.VarChar(50)
  subject   String   @db.VarChar(255)
  bodyHtml  String   @map("body_html") @db.Text
  bodyText  String   @map("body_text") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code, isActive])
  @@map("notification_templates")
}

model NotificationPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  emailEnabled Boolean  @default(true) @map("email_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId])
  @@map("notification_preferences")
}

model ScheduledJobLog {
  id             String   @id @default(uuid()) @db.Uuid
  jobName        String   @map("job_name") @db.VarChar(100)
  status         String   @db.VarChar(50)
  durationMs     Int      @default(0) @map("duration_ms")
  itemsProcessed Int      @default(0) @map("items_processed")
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([jobName, createdAt])
  @@map("scheduled_job_logs")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PHASE 8: ADVANCED ADMIN & RECRUITER ECOSYSTEM
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model TalentPool {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())

  candidates TalentPoolCandidate[]
  company    Company               @relation(fields: [companyId], references: [id])

  @@map("talent_pools")
}

model TalentPoolCandidate {
  id          String   @id @default(uuid()) @db.Uuid
  poolId      String   @map("pool_id") @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  addedAt     DateTime @default(now())
  matchScore  Float?   @map("match_score")
  notes       String?

  pool      TalentPool       @relation(fields: [poolId], references: [id])
  candidate CandidateProfile @relation(fields: [candidateId], references: [id])

  @@unique([poolId, candidateId])
  @@map("talent_pool_candidates")
}

model AILog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  promptType String
  tokensUsed Int      @map("tokens_used")
  cost       Float
  createdAt  DateTime @default(now())

  @@map("ai_logs")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PHASE 10 — HIGH & MEDIUM VALUE FEATURE LAYER
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ── Feature 1: AI Interview Module ───────────────────────────

model Interview {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  roleProfileId String?             @map("role_profile_id") @db.Uuid
  title         String              @db.VarChar(255)
  description   String?             @db.Text
  status        InterviewStatus     @default(DRAFT)
  type          InterviewType       @default(ASYNC_TEXT)
  timeLimitMins Int?                @map("time_limit_mins")
  passingScore  Float               @default(70) @map("passing_score")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  questions AIInterviewQuestion[]
  sessions  InterviewSession[]

  @@index([companyId])
  @@index([status])
  @@map("interviews")
}

model AIInterviewQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  interviewId String   @map("interview_id") @db.Uuid
  text        String   @db.Text
  category    String?  @db.VarChar(100)
  difficulty  String?  @db.VarChar(50)
  sortOrder   Int      @map("sort_order")
  maxPoints   Int      @default(10) @map("max_points")
  rubric      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  interview Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answers   InterviewAnswer[]

  @@index([interviewId])
  @@map("interview_questions")
}

model InterviewSession {
  id          String        @id @default(uuid()) @db.Uuid
  interviewId String        @map("interview_id") @db.Uuid
  candidateId String        @map("candidate_id") @db.Uuid
  journeyId   String?       @map("journey_id") @db.Uuid
  status      SessionStatus @default(INVITED)
  startedAt   DateTime?     @map("started_at")
  submittedAt DateTime?     @map("submitted_at")
  expiresAt   DateTime?     @map("expires_at")
  totalScore  Float?        @map("total_score")
  isPassed    Boolean?      @map("is_passed")
  aiReport    Json?         @map("ai_report")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  interview Interview       @relation(fields: [interviewId], references: [id])
  answers   InterviewAnswer[]
  recordings InterviewRecording[]

  @@index([interviewId])
  @@index([candidateId])
  @@map("interview_sessions")
}

model InterviewAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  answerText String   @db.Text
  score      Float?
  aiFeedback String?  @db.Text @map("ai_feedback")
  createdAt  DateTime @default(now()) @map("created_at")

  session  InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question AIInterviewQuestion @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@map("interview_answers")
}

enum InterviewStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InterviewType {
  ASYNC_TEXT
}

enum SessionStatus {
  INVITED
  STARTED
  SUBMITTED
  EVALUATED
}

// ── Feature 3: Webhook / ATS Integration ─────────────────────

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  url       String   @db.Text
  secret    String   @db.Text
  events    String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid()) @db.Uuid
  webhookId    String    @map("webhook_id") @db.Uuid
  event        String
  payload      Json
  responseCode Int?      @map("response_code")
  responseBody String?   @db.Text @map("response_body")
  attempts     Int       @default(1)
  deliveredAt  DateTime? @map("delivered_at")
  failedAt     DateTime? @map("failed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_deliveries")
}

// ── Feature 6: 2-Way In-Platform Messaging ───────────────────

model MessageThread {
  id        String   @id @default(uuid()) @db.Uuid
  journeyId String   @unique @map("journey_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  messages Message[]

  @@map("message_threads")
}

model Message {
  id         String    @id @default(uuid()) @db.Uuid
  threadId   String    @map("thread_id") @db.Uuid
  senderId   String    @map("sender_id") @db.Uuid
  senderRole String    @map("sender_role") @db.VarChar(50)
  body       String    @db.Text
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@map("messages")
}

// ── Feature 8: AI Question Bank ──────────────────────────────

model QuestionBank {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  question     String   @db.Text
  type         String   @db.VarChar(50)
  difficulty   String   @db.VarChar(50)
  skills       String[]
  competencies String[]
  options      Json?
  explanation  String?  @db.Text
  timesUsed    Int      @default(0) @map("times_used")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([difficulty])
  @@map("question_bank")
}

// ── Feature 9: Referral & Affiliate System ───────────────────

model CandidateReferral {
  id           String    @id @default(uuid()) @db.Uuid
  referrerId   String    @map("referrer_id") @db.Uuid
  refereeId    String?   @map("referee_id") @db.Uuid
  referralCode String    @unique @map("referral_code") @db.VarChar(32)
  status       String    @default("PENDING") @db.VarChar(50)
  rewardType   String?   @map("reward_type") @db.VarChar(50)
  rewardValue  Float?    @map("reward_value")
  convertedAt  DateTime? @map("converted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  rewards      ReferralReward[]

  @@index([referrerId])
  @@index([referralCode])
  @@map("referrals")
}

// ── Feature 12: Diversity & Inclusion Analytics ──────────────

model DiversityAnalytics {
  id            String   @id @default(uuid()) @db.Uuid
  candidateId   String   @unique @map("candidate_id") @db.Uuid
  gender        String?  @db.VarChar(50)
  ageRange      String?  @map("age_range") @db.VarChar(50)
  ethnicity     String?  @db.VarChar(100)
  disability    Boolean?
  veteranStatus Boolean? @map("veteran_status")
  providedAt    DateTime @default(now()) @map("provided_at")

  @@map("diversity_datapoints")
}

// ── Feature 5: Slack Integration ─────────────────────────────

model SlackIntegration {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @unique @map("company_id") @db.Uuid
  webhookUrl  String   @map("webhook_url") @db.Text
  channelName String?  @map("channel_name") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  events      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("slack_integrations")
}

// ── New Models for Phase 10 ─────────────────────────────

model InterviewRecording {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  url         String   @db.Text
  durationMs  Int      @default(0) @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("interview_recordings")
}

model ReferralReward {
  id           String   @id @default(uuid()) @db.Uuid
  referralId   String   @map("referral_id") @db.Uuid
  rewardType   String   @db.VarChar(50)
  rewardValue  Float
  grantedAt    DateTime @default(now()) @map("granted_at")

  referral     CandidateReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@map("referral_rewards")
}

model AIJobDescription {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  roleProfileId String?  @map("role_profile_id") @db.Uuid
  originalText  String?  @db.Text
  aiGenerated   String   @db.Text
  status        String   @default("DRAFT") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("ai_job_descriptions")
}

model AIOfferLetter {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  content     String   @db.Text
  status      String   @default("DRAFT") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([candidateId])
  @@index([companyId])
  @@map("ai_offer_letters")
}

// -----------------------------------------------------------------------------
// PROFESSIONAL NETWORK MODELS
// -----------------------------------------------------------------------------

model Connection {
  id           String   @id @default(uuid()) @db.Uuid
  requesterId  String   @map("requester_id") @db.Uuid
  recipientId  String   @map("recipient_id") @db.Uuid
  status       ConnectionStatus @default(PENDING)
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@unique([requesterId, recipientId])
  @@map("connections")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model NetworkPost {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  content      String   @db.Text
  postType     PostType @map("post_type") // PROJECT, ACHIEVEMENT, LEARNING, INSIGHT, OPPORTUNITY
  
  // Optional References
  projectId    String?  @map("project_id") @db.Uuid // Link to CandidatePortfolio
  assessmentId String?  @map("assessment_id") @db.Uuid // Link to CandidateJourney/Assessment
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  reactions    PostReaction[]
  comments     PostComment[]

  @@map("network_posts")
}

enum PostType {
  PROJECT
  ACHIEVEMENT
  LEARNING
  INSIGHT
  OPPORTUNITY
}

model PostReaction {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50) // LIKE, CELEBRATE, SUPPORT, INSIGHTFUL
  createdAt DateTime @default(now()) @map("created_at")
  
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@map("post_reactions")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@map("post_comments")
}

model Recommendation {
  id          String   @id @default(uuid()) @db.Uuid
  giverId     String   @map("giver_id") @db.Uuid
  receiverId  String   @map("receiver_id") @db.Uuid
  skillId     String?  @map("skill_id") @db.Uuid
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("recommendations")
}
