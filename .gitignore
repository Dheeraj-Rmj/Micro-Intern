# ============================================================
# MicroIntern — .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
.turbo/
out/

# Environment variables — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/

# Prisma
packages/database/src/generated/

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.swp
*.swo
*~

# Docker
.docker-data/
minio-data/

# TypeScript
*.tsbuildinfo

# Package manager
.pnpm-store/

# Misc
*.pem
.vercel
