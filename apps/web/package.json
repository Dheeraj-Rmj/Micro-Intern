{
  "name": "@microintern/web",
  "version": "0.1.0",
  "private": true,
  "description": "MicroIntern Web — Next.js 15 Multi-Portal Frontend",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --reporter=verbose --passWithNoTests src",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf .next dist"
  },
  "dependencies": {
