    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.16.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
