{
  "name": "@microintern/api",
  "version": "0.1.0",
  "private": true,
  "description": "MicroIntern REST API — Express + TypeScript",
  "main": "dist/core/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/core/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/core/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose tests/unit",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@microintern/database": "workspace:*",
    "@microintern/shared": "workspace:*",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "hpp": "^0.2.3",
    "express-rate-limit": "^7.4.1",
    "rate-limit-redis": "^4.2.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "@prisma/client": "^5.21.1",
    "ioredis": "^5.4.1",
    "bullmq": "^5.19.1",
    "minio": "^8.0.1",
    "@aws-sdk/client-s3": "^3.682.0",
    "@aws-sdk/s3-request-presigner": "^3.682.0",
    "nodemailer": "^6.9.16",
    "handlebars": "^4.7.8",
    "groq-sdk": "^0.7.0",
    "@google/generative-ai": "^0.21.0",
    "@huggingface/inference": "^2.8.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "uuid": "^10.0.0",
    "ms": "^2.1.3",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@microintern/config": "workspace:*",
    "@faker-js/faker": "^9.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.16",
    "@types/passport": "^1.0.16",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
